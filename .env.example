# --- LLM (Groq) ---
GROQ_API_KEY_1=your_groq_key_here
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b

# --- Google Maps (optional: traffic-aware routes, transit, nearby places) ---
GOOGLE_MAPS_API_KEY=

# --- Redis (sessions + caches) ---
REDIS_HOST=localhost
REDIS_PORT=6379
SESSION_TTL_S=86400

# --- Estimates / links (config, not code) ---
# Travel cost = fuel price / mileage (derived, no magic literal).
# Hyderabad petrol 2026-10-26: Rs 116.15/L.
FUEL_PRICE_PER_LITER=116.15
VEHICLE_MILEAGE_KMPL=14.0
FALLBACK_TRANSIT_LINK=https://www.redbus.in/

# --- Budget agent (config, not code) ---
BUDGET_MEALS_PER_DAY=3

# --- Providers ---
OSRM_ENABLED=true
NOMINATIM_ENABLED=true
