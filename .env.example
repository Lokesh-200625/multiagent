# Groq
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b

# PostgreSQL / Supabase
DATABASE_URL=

# Redis (Docker Compose overrides these for the API)
REDIS_HOST=localhost
REDIS_PORT=6379

# OpenRouteService
ORS_ENABLED=true
ORS_URL=https://api.openrouteservice.org/v2/directions/driving-car
ORS_API_KEY=
ORS_TIMEOUT_S=5
ORS_DAILY_QUOTA=1500

# OSRM
OSRM_ENABLED=true
OSRM_URL=https://router.project-osrm.org
OSRM_TIMEOUT_S=5

# Nominatim
NOMINATIM_ENABLED=true
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=PilgrimAI/1.0
NOMINATIM_TIMEOUT_S=5
NOMINATIM_MIN_INTERVAL_S=1.1

# Caching
TTL_GEOCODE_S=2592000
TTL_ROUTE_S=86400
TTL_NEGATIVE_S=30
TRANSIT_CACHE_TTL_S=21600
