-    def is_generic(entity) -> bool:
-        return (
-            entity.mention.strip().lower()
-            in generic_terms
-        )
-
-    result.entities = [
-        entity
-        for entity in result.entities
-        if not is_generic(entity)
-    ]
-
-    for subquery in result.subqueries:
-        subquery.entities = [
-            entity
-            for entity in subquery.entities
-            if not is_generic(entity)
-        ]
